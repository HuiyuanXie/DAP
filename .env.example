# Official OpenAI Responses defaults; select a model available to your account.
OPENAI_API_KEY=
BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
API_STYLE=responses

# Common controls: on / off / default. default omits reasoning API parameters.
THINKING=default
REASONING_FORMAT=auto
# REASONING_EFFORT=low
MAX_OUTPUT_TOKENS=1800
# Set false for a selected model that does not accept reasoning effort none.
THINKING_OFF_SUPPORTED=true

# Yeysai / switchable DeepSeek Chat example:
# BASE_URL=https://yeysai.com/v1
# MODEL=deepseek-v4.1-flash
# API_STYLE=chat_completions
# REASONING_FORMAT=thinking
# THINKING=off

# For a legacy always-reasoning model with no API toggle:
# REASONING_FORMAT=always_on
# THINKING=default
